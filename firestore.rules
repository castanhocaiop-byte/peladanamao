rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userGlobalRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function userLeagueRole(leagueId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        .get('leagues', {}).get(leagueId, {}).get('role', 'none');
    }

    function isGlobalAdmin() {
      return isSignedIn() && (
        isOwnerVerified() ||
        userGlobalRole() == 'admin'
      );
    }

    function isLeagueAdmin(leagueId) {
      return isSignedIn() && (
        isOwnerVerified() ||
        userLeagueRole(leagueId) == 'admin'
      );
    }

    function isLeagueActiveUser(leagueId) {
      return isSignedIn() && (
        userLeagueRole(leagueId) == 'admin' ||
        userLeagueRole(leagueId) == 'player'
      );
    }

    function userPlayerKey(leagueId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        .get('leagues', {}).get(leagueId, {}).get('playerKey',
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('playerKey', ''));
    }

    function userTopPlayerKey() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('playerKey', '');
    }

    // Dono do sistema: precisa do e-mail VERIFICADO (conta Google); o texto do e-mail sozinho não vale.
    function isOwnerVerified() {
      return isSignedIn()
        && request.auth.token.email == 'castanho.caiop@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Verdadeiro quando o documento NÃO ganha nem muda o campo "whatsapp": apagar o campo, ou deixá-lo
    // como já estava num documento antigo ainda não migrado, é permitido. Vale só para create/update.
    function keepsWhatsappOut() {
      return !('whatsapp' in request.resource.data)
        || (resource != null && request.resource.data.whatsapp == resource.data.get('whatsapp', null));
    }

    function validPhotoDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['url', 'uid', 'updatedAt'])
        && d.url is string
        && d.url.size() < 300
        && d.url.matches('^https://res\\.cloudinary\\.com/fwtyio7l/.*')
        && d.uid is string;
    }

    // ── Global collections ───────────────────────────────────────

    // Papel, ligas e vínculo com jogador NÃO são gravados pelo app: só as Cloud Functions
    // (joinLeague, createLeague, leaveLeague, manageMember, saveEarnedBadges) mexem nesses
    // campos, com permissão de servidor. O usuário só cria o próprio documento "vazio"
    // (sem papel e sem ligas) e edita os campos de notificação dele.
    //
    // Privacidade (LGPD): cada conta lê SÓ o próprio cadastro. Nome, e-mail e vínculo de outras
    // pessoas chegam ao admin da liga pela função listMembers, que devolve apenas o que o
    // Painel Admin usa (sem tokens de notificação e sem dados de outras ligas).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && (
        isOwnerVerified() ||
        (request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'createdAt', 'leagues'])
          && request.resource.data.role == 'pending'
          && request.resource.data.leagues is map
          && request.resource.data.leagues.size() == 0
          && request.resource.data.email == request.auth.token.get('email', ''))
      );
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['fcmTokens', 'notifEnabled', 'linkRequestSent']);
      allow delete: if false;
    }

    match /users/{uid}/badgeNotifs/{docId} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read, delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ── League data (/leagues/{leagueId}/) ───────────────────────

    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      // Ligas novas nascem na função createLeague (que também torna o criador admin dela).
      allow create: if false;
      // Plano, assinatura, criador e controle de encerramento só o servidor grava (o Admin SDK
      // ignora estas regras): se o admin pudesse gravar tudo, daria a si mesmo um plano pago
      // direto pelo navegador. O admin da liga só renomeia a própria liga.
      allow update: if isOwnerVerified()
        || (isLeagueAdmin(leagueId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']));
      allow delete: if isGlobalAdmin();
    }

    match /leagues/{leagueId}/championships/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueActiveUser(leagueId);
    }

    match /leagues/{leagueId}/player_titles/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueAdmin(leagueId);
    }

    // O WhatsApp NÃO fica no cadastro do elenco (todo membro lê): vai para "contacts", só do admin.
    match /leagues/{leagueId}/player_registry/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow create, update: if isLeagueAdmin(leagueId) && keepsWhatsappOut();
      allow delete: if isLeagueAdmin(leagueId);
    }

    // Contatos (WhatsApp) de jogadores e avulsos: só o admin lê e grava.
    // Jogador: id do cadastro. Avulso: "avulso_" + chave do nome.
    match /leagues/{leagueId}/contacts/{docId} {
      allow read, write: if isLeagueAdmin(leagueId);
    }

    // Foto de perfil: docId = playerKey (nome normalizado). O próprio jogador
    // grava/apaga a sua; o admin grava/apaga qualquer uma.
    match /leagues/{leagueId}/player_photos/{photoKey} {
      allow read: if isLeagueActiveUser(leagueId);
      allow create, update: if validPhotoDoc() && (
        isLeagueAdmin(leagueId) ||
        (isLeagueActiveUser(leagueId)
          && request.resource.data.uid == request.auth.uid
          && (userPlayerKey(leagueId) == photoKey || userTopPlayerKey() == photoKey))
      );
      allow delete: if isLeagueAdmin(leagueId) ||
        (isLeagueActiveUser(leagueId) && resource.data.uid == request.auth.uid);
    }

    match /leagues/{leagueId}/financeiro_config/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/financeiro_mensalidades/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/financeiro_despesas/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/financeiro_avulsos/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow create, update: if isLeagueAdmin(leagueId) && keepsWhatsappOut();
      allow delete: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/mensalidade_lembretes/{docId} {
      allow create: if isLeagueAdmin(leagueId);
      allow read, delete: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/app_config/{docId} {
      allow read: if isLeagueActiveUser(leagueId);
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/link_requests/{uid} {
      allow read: if isLeagueAdmin(leagueId) || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isLeagueAdmin(leagueId);
    }

    // Convites: só o admin cria, lista e apaga. Quem entra por convite passa pela função
    // joinLeague, que lê e consome o convite com permissão de servidor.
    match /leagues/{leagueId}/invite_tokens/{token} {
      allow read, create, delete: if isLeagueAdmin(leagueId);
      allow update: if false;
    }

    // Pagamentos do plano anual já somados ao vencimento da liga (um registro por pagamento do
    // Mercado Pago, que impede somar o mesmo pagamento duas vezes). Só o servidor lê e escreve.
    match /leagues/{leagueId}/billing_payments/{paymentId} {
      allow read, write: if false;
    }

    // Marca do checkout de cada liga (quantas vezes abriu o pagamento): alimenta o painel de métricas do dono.
    // Fica dentro da liga, então some junto com ela no encerramento. Só o servidor lê e escreve.
    match /leagues/{leagueId}/billing_meta/{docId} {
      allow read, write: if false;
    }

    // Métricas do funil (painel só do dono): contadores anônimos de uso por dia e retrato diário do funil.
    // Nenhum dado pessoal; só o servidor (Admin SDK) lê e escreve.
    match /metrics_events/{day} {
      allow read, write: if false;
    }
    match /metrics_daily/{day} {
      allow read, write: if false;
    }

    // Contadores internos de limite de chamadas (rate limiting) das Cloud Functions.
    // Só o servidor (Admin SDK, que ignora estas regras) lê e escreve aqui.
    match /rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
